# Core authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ALLOWED_EMAIL=

# Optional AI. Nudge works without this using rule-based insights.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Optional service-account bridge for unattended December 31 Wrapped generation.
# Paste the full service-account JSON as Base64 to avoid newline problems.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Cron secret used by Vercel Cron endpoint. Keep private.
CRON_SECRET=

# Local development only. Never enable in production.
NUDGE_DEV_BYPASS=false
